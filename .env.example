# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_NAME=ICICI Prudential Facts-Only RAG Assistant
LOG_LEVEL=INFO

# Answer generation (Gemini, Google AI Studio key). Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
LLM_TIMEOUT_SECONDS=45
CHAT_RATE_LIMIT_PER_MINUTE=20
BGE_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_MIN_SCORE=0.5

# Relative paths are resolved from the repository root.
RAW_SOURCES_DIR=data/raw_sources
EXTRACTED_TEXT_DIR=data/extracted_text
PROCESSED_DIR=data/processed
INDEXES_DIR=data/indexes
LOGS_DIR=data/logs
SOURCE_REGISTRY_PATH=data/source_registry.json

# OCR fallback for pages without usable native text (e.g. outlined-text factsheets).
TESSERACT_CMD=tesseract
OCR_DPI=300
# Second, independent OCR pass used to confirm OCR-read numbers.
OCR_CHECK_DPI=400
